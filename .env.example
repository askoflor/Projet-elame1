# Copier ce fichier en ".env" sur le VPS et remplir les valeurs avant de lancer
# `docker compose up -d --build`.

# --- Base de donnees MySQL ---
MYSQL_DATABASE=backend_db
MYSQL_USER=backend
MYSQL_PASSWORD=change_me_strong_password
MYSQL_ROOT_PASSWORD=change_me_strong_root_password

# --- Backend Spring Boot ---
# Port expose sur le VPS pour l'API
BACKEND_PORT=8080
# Origines autorisees a appeler l'API (mettre l'URL publique du frontend en prod)
CORS_ALLOWED_ORIGINS=*

# --- Frontend Flutter web ---
# Port expose sur le VPS pour le site
FRONTEND_PORT=80
# URL publique par laquelle le navigateur des utilisateurs pourra joindre l'API
# (IP ou domaine du VPS + BACKEND_PORT). Utilisee au moment du build du frontend.
API_BASE_URL=http://VOTRE_IP_VPS:8080
USE_MOCK_BACKEND=false
