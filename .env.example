# Copier ce fichier en ".env" sur le VPS et remplir les valeurs avant de lancer
# `docker compose up -d --build`.

# --- Base de donnees MySQL ---
MYSQL_DATABASE=backend_db
MYSQL_USER=backend
MYSQL_PASSWORD=change_me_strong_password
MYSQL_ROOT_PASSWORD=change_me_strong_root_password

# --- Backend Spring Boot ---
# Port expose sur le VPS pour l'API
BACKEND_PORT=8080
# Origines autorisees a appeler l'API (mettre l'URL publique du frontend en prod)
CORS_ALLOWED_ORIGINS=*
# Dossier sur le VPS (hors conteneur) ou sont stockes les fichiers persistants
# (uploads utilisateurs, fichiers applicatifs). Monte dans le conteneur backend
# sur /app/storage. Doit exister sur le VPS avant le premier `docker compose up`,
# avec les sous-dossiers storage/users et storage/application :
#   sudo mkdir -p /opt/projet-elame/storage/{users,application}
STORAGE_HOST_PATH=/opt/projet-elame/storage

# Cle secrete utilisee pour signer les jetons JWT (connexion/inscription).
# Generez une valeur aleatoire longue, par exemple avec :
#   openssl rand -base64 48
JWT_SECRET=change_me_random_secret_at_least_32_characters_long
# Duree de validite des jetons, en millisecondes (defauts : 24h / 7 jours)
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Envoi d'email (verification d'adresse a l'inscription) ---
# Compte Gmail utilise comme expediteur. Necessite un "mot de passe
# d'application" Google (Compte Google > Securite > Validation en 2 etapes >
# Mots de passe des applications) car Gmail n'accepte plus les mots de passe
# de compte classiques pour l'envoi SMTP applicatif.
MAIL_USERNAME=florentassakoj@gmail.com
MAIL_PASSWORD=change_me_gmail_app_password

# --- MinIO (stockage objet S3-compatible) ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me_strong_minio_password
# Port de l'API S3 / port de la console web d'administration
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Dossier sur le VPS ou MinIO stocke ses donnees : un sous-dossier dedie sous
# STORAGE_HOST_PATH, distinct de storage/users et storage/application. MinIO
# gere ce dossier lui-meme dans son propre format (buckets/objets) : aucun
# autre service ne doit y ecrire de fichiers directement. Doit exister sur le
# VPS avant le premier `docker compose up` :
#   sudo mkdir -p /opt/projet-elame/storage/minio/data
MINIO_HOST_PATH=/opt/projet-elame/storage/minio/data

# --- Frontend Flutter web ---
# Port expose sur le VPS pour le site
FRONTEND_PORT=80
# URL publique par laquelle le navigateur des utilisateurs pourra joindre l'API
# (IP ou domaine du VPS + BACKEND_PORT). Utilisee au moment du build du frontend.
API_BASE_URL=http://VOTRE_IP_VPS:8080
USE_MOCK_BACKEND=false
